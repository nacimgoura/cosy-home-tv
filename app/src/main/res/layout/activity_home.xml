<?xml version="1.0" encoding="utf-8"?>
<!-- 960x540dp canvas on a 1080p TV: the mockup's pixel values halved. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <com.cosyhome.tv.SceneView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim" />

    <!-- One page: the clock screen fills the first screen, the rest of the apps follow under the dock and
         scroll up on Down. The grid's padding (clipToPadding off) is the room a zoomed tile and the cat draw into. -->
    <com.cosyhome.tv.RoomyScrollView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Clock screen, as tall as the screen (HomeActivity sets it). Shifted a few dp every minute so
                 nothing sits still on an OLED panel. -->
            <FrameLayout
                android:id="@+id/homeLayer"
                android:layout_width="match_parent"
                android:layout_height="540dp"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="66dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 200"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:textSize="150sp" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Top right, as in cleanyourtv's Glass: Sources (with inputs), Wi-Fi, Settings. -->
                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="72dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sources"
                        style="@style/Chip"
                        android:layout_height="40dp"
                        android:background="@drawable/pill_bg"
                        android:drawableStart="@drawable/ic_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="@string/sources"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/wifi"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/pill_bg"
                        android:clickable="true"
                        android:contentDescription="@string/wifi"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/chip_text" />

                    <ImageView
                        android:id="@+id/settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/pill_bg"
                        android:clickable="true"
                        android:contentDescription="@string/settings"
                        android:focusable="true"
                        android:scaleType="center"
                        android:src="@drawable/ic_gear"
                        android:tint="@color/chip_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="48dp"
                    android:layout_marginBottom="52dp"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- A hairline between the dock and the rest of the apps (HomeActivity places it in the gap). -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF" />

            <GridLayout
                android:id="@+id/appsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="6"
                android:paddingBottom="40dp"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </com.cosyhome.tv.RoomyScrollView>

    <!-- Sources dropdown under the pill: Live TV, the HDMI ports, USB. -->
    <com.cosyhome.tv.GlassPanel
        android:id="@+id/inputsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="72dp"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inputs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:orientation="vertical" />
    </com.cosyhome.tv.GlassPanel>

    <!-- The black cat sits on the focused tile and jumps to the next one (HomeActivity.moveCat). -->
    <ImageView
        android:id="@+id/cat"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:importantForAccessibility="no"
        android:src="@drawable/cat"
        android:visibility="invisible" />
</FrameLayout>
