<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Weather for the clock (Open-Meteo, no account). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fire OS drops sound_effects_enabled to 0 when audio goes to an external system; put it back on start. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: the apps shown as tiles, and the Philips screens the chips open. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.droidtv.action.AMBILIGHT_OSD" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- The Store pill opens the Fire TV Appstore, or the Play Store on Android TV. -->
        <package android:name="com.amazon.venezia" />
        <package android:name="com.android.vending" />
        <!-- The Wi-Fi and Settings pills prefer Kara Settings once Amazon's launcher is gone. -->
        <package android:name="local.kara.settingsredirector" />
        <!-- Fire OS's own settings screens: the Wi-Fi pill opens the network one directly. -->
        <package android:name="com.amazon.tv.settings.v2" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Cosy"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the stock launcher's app list too, so it can be opened before it owns Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
